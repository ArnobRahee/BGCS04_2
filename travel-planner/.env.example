# Copy to .env and fill in. Never commit .env.

# Aivana (optional). Without these the app uses its local ranking, templates and rule-based chat.
AIVANA_API_KEY=
AIVANA_API_URL=
# "openai" = body {model, messages} -> choices[0].message.content ; "prompt" = body {prompt} -> response
AIVANA_API_STYLE=openai
AIVANA_MODEL=

# NCAA data (free ncaa-api, 3 requests/second). Point at your own copy for heavy use:
#   docker run --rm -p 3000:3000 henrygd/ncaa-api   ->   NCAA_API_URL=http://localhost:3000
NCAA_API_URL=https://ncaa-api.henrygd.me

# Supabase project "Camerok's Project" (org: Hackathon 2026).
SUPABASE_URL=https://mucqewiinntpqhdhektw.supabase.co
# Publishable key: safe for browsers; used only for sign-in.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_M9cHcbdY7gSqHN0QhZ0j9w_MDmnbpRU
# Secret key: Supabase dashboard > Project Settings > API Keys > Secret keys (sb_secret_...).
# Server only. It bypasses row level security: never put it in frontend code or commit it.
# Leave empty to run in demo mode (in-memory data, one-click demo accounts).
SUPABASE_SERVICE_KEY=
